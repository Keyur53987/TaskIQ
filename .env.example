APP_ENV=development
APP_URL=http://localhost:8000
# Use PostgreSQL for public deployments. SQLite is development-only.
DATABASE_URL=sqlite:///./taskiq.db
# Google Cloud Console: OAuth client type Web application.
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing optional task-extraction provider; Phase 1 sign-in needs no Gemini key.
GEMINI_API_KEY=
# Select and validate an available model before enabling live AI. The prototype
# default gemini-2.5-flash is deprecated; see Google's current deprecation schedule.
GEMINI_MODEL=gemini-2.5-flash
# Production defaults to disabled; enable only after setting quotas/budget alerts.
AI_ENABLED=true
